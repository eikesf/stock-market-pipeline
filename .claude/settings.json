{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create*)",
            "command": "${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/check-readme-before-pr.sh",
            "timeout": 30,
            "statusMessage": "Checking README.md is updated before opening the PR..."
          }
        ]
      }
    ]
  }
}
